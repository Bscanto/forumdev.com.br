# Aplicação
JWT_SECRET=change-this-to-a-long-random-secret

# Banco PostgreSQL
# Em produção, use a connection string do Supabase (preferencialmente Session Pooler na Vercel).
DATABASE_URL=

# Desenvolvimento local com Docker/PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=local_user
POSTGRES_DB=local_db
POSTGRES_PASSWORD=change-me

# Migração Neon -> Supabase (somente terminal local; não configure na Vercel)
OLD_DB_URL=
NEW_DB_URL=

# Seed de administrador
SEED_ADMIN_NAME=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
