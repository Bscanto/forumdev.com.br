{
  "name": "forumdev.com.br",
  "version": "1.0.0",
  "description": "Criação de um Forum sobre Programação e Tecnologia",
  "main": "index.js",
  "scripts": {
    "dev": "npm run services:up && next dev",
    "dev:app": "next dev",
    "build": "next build",
    "start": "next start",
    "services:up": "docker compose -f infra/compose.yaml up -d",
    "services:stop": "docker compose -f infra/compose.yaml stop",
    "services:down": "docker compose -f infra/compose.yaml down",
    "lint:check": "prettier --check .",
    "lint:fix": "prettier --write .",
    "test": "jest --runInBand",
    "test:watch": "jest --watchAll --runInBand",
    "migration:create": "node-pg-migrate create --migrations-dir infra/migrations",
    "migration:up": "node-pg-migrate up --migrations-dir infra/migrations --envPath .env.development",
    "migration:down": "node-pg-migrate down --migrations-dir infra/migrations --envPath .env.development"
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.4",
    "dotenv-expand": "^11.0.6",
    "jsonwebtoken": "^9.0.2",
    "next": "15.5.27",
    "node-pg-migrate": "9.0.0",
    "pg": "8.23.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "jest": "30.5.2",
    "prettier": "^3.8.0"
  },
  "engines": {
    "node": ">=22 <25"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.28"
    }
  }
}
